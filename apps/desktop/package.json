{
  "name": "@irbis/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "IRBIS Windows desktop shell",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@irbis/charts": "*",
    "@irbis/connect": "*",
    "@irbis/core": "*",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "maplibre-gl": "^6.15.0",
    "onvif": "^0.8.3",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
